{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./**/*.ts"],
  "exclude": [
    "../artifacts/**"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["../src/*"]
    }
  }
}
